APP_NAME="Transtechno Cameroun"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://transtechno-cmr.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Base de données MySQL cPanel ────────────────────────────────────────────
# Créer la base et l'utilisateur dans cPanel → Bases de données MySQL
# Le nom de la base est toujours préfixé par le nom d'utilisateur cPanel
# Ex : si ton user cPanel est "transtech", la base sera "transtech_transtechno"
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANEL_USER_transtechno
DB_USERNAME=CPANEL_USER_transtechno
DB_PASSWORD=MOT_DE_PASSE_MYSQL

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

# Recherche MySQL Full-Text
SCOUT_DRIVER=database
SCOUT_QUEUE=false

CACHE_STORE=redis

# ── Redis PlanetHoster ───────────────────────────────────────────────────────
# Activer Redis dans N0C → Performances → Redis
# En production PlanetHoster : utiliser le socket Unix
REDIS_CLIENT=predis
REDIS_SCHEME=unix
REDIS_HOST=/home/CPANEL_USER/.redis/redis.sock
REDIS_PORT=0
REDIS_PASSWORD=null

# ── Email SMTP PlanetHoster ──────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=node62-eu.n0c.com
MAIL_PORT=587
MAIL_USERNAME=office@transtechno-cmr.com
MAIL_PASSWORD=MOT_DE_PASSE_SMTP
MAIL_FROM_ADDRESS="office@transtechno-cmr.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── N0C Storage S3-compatible ────────────────────────────────────────────────
# Endpoint N0C Storage — certificat auto-signé, port 5443
# Les fichiers sont servis via /media-proxy/ (voir routes/web.php)
AWS_ACCESS_KEY_ID=CLE_ACCES_N0C_STORAGE
AWS_SECRET_ACCESS_KEY=CLE_SECRETE_N0C_STORAGE
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=NOM_DU_BUCKET_N0C
AWS_ENDPOINT=https://ht2-storage.n0c.com:5443
AWS_URL=https://transtechno-cmr.com/media-proxy
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── Sauvegardes (spatie/laravel-backup) ─────────────────────────────────────
# Mot de passe pour chiffrer l'archive ZIP du backup (recommandé)
BACKUP_ARCHIVE_PASSWORD=MOT_DE_PASSE_BACKUP_A_DEFINIR
# Email qui reçoit les alertes en cas d'échec de backup
BACKUP_NOTIFICATION_EMAIL=transtechno.cm@gmail.com

VITE_APP_NAME="${APP_NAME}"
